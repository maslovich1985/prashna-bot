# --- Telegram ---
TELEGRAM_TOKEN=123456:ABC-DEF_ваш_токен_от_BotFather

# --- Groq ---
GROQ_API_KEY=gsk_ваш_ключ
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=90
GROQ_MAX_TOKENS=1800

# --- Хранилище ---
DB_PATH=/opt/prashna-bot/data/prashna.sqlite3
LOG_LEVEL=INFO

# --- Поддержка по платежам (/paysupport): @username или почта; пусто = без контакта ---
SUPPORT_CONTACT=

# --- Антиспам ---
DAILY_LIMIT=5
COOLDOWN_SECONDS=30
ADMIN_IDS=

# --- Место по умолчанию (если пользователь не задал свой город) ---
DEFAULT_CITY=Москва
DEFAULT_LAT=55.7558
DEFAULT_LON=37.6173
DEFAULT_TZ=Europe/Moscow

# --- Геокодер (Nominatim; укажите свой контакт в User-Agent) ---
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_UA=prashna-bot/1.0 (contact: you@example.com)

# --- Аянамша: LAHIRI | RAMAN | KRISHNAMURTI | YUKTESHWAR | TRUE_CITRA ---
AYANAMSA=LAHIRI

# --- Прокси для запросов к LLM (пусто = напрямую) ---
# Пример: http://user:pass@1.2.3.4:8080
LLM_PROXY=
