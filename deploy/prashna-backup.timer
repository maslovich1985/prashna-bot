[Unit]
Description=Ежедневный бэкап базы прашна-бота (~03:30)

[Timer]
OnCalendar=*-*-* 03:30:00
# Ночью бот почти не занят, точная минута не важна: разброс снимает совпадение
# с другими ночными задачами на том же VPS.
RandomizedDelaySec=15m
# VPS может быть выключен в 03:30 — тогда бэкап сделается при следующем старте,
# а не пропустится до завтра.
Persistent=true
Unit=prashna-backup.service

[Install]
WantedBy=timers.target
